{
  "primitive": {
    "color": {
      "black": {
        "$value": "#08080A"
      },
      "ink": {
        "$value": "#111114"
      },
      "graphite": {
        "$value": "#1A1A1E"
      },
      "line": {
        "$value": "#26262B"
      },
      "steel": {
        "$value": "#8C8F98"
      },
      "bone": {
        "$value": "#F2F2F0"
      },
      "red": {
        "$value": "#E5202E"
      },
      "red-dim": {
        "$value": "#9E1620"
      }
    },
    "font": {
      "display": {
        "$value": "var(--font-archivo), 'Arial Black', system-ui, sans-serif"
      },
      "body": {
        "$value": "var(--font-archivo), system-ui, sans-serif"
      },
      "mono": {
        "$value": "var(--font-roboto-mono), ui-monospace, monospace"
      }
    },
    "radius": {
      "sm": {
        "$value": "2px"
      },
      "md": {
        "$value": "4px"
      }
    },
    "ease": {
      "out": {
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "inout": {
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      }
    },
    "duration": {
      "fast": {
        "$value": "200ms"
      },
      "base": {
        "$value": "450ms"
      },
      "slow": {
        "$value": "900ms"
      }
    }
  },
  "semantic": {
    "ds": {
      "color": {
        "background": {
          "$value": "{primitive.color.black}"
        },
        "foreground": {
          "$value": "{primitive.color.bone}"
        },
        "card": {
          "$value": "{primitive.color.ink}"
        },
        "card-foreground": {
          "$value": "{primitive.color.bone}"
        },
        "muted": {
          "$value": "{primitive.color.graphite}"
        },
        "muted-foreground": {
          "$value": "{primitive.color.steel}"
        },
        "border": {
          "$value": "{primitive.color.line}"
        },
        "accent": {
          "$value": "{primitive.color.red}"
        },
        "on-accent": {
          "$value": "{primitive.color.bone}"
        },
        "accent-dim": {
          "$value": "{primitive.color.red-dim}"
        },
        "ring": {
          "$value": "{primitive.color.bone}"
        }
      },
      "font": {
        "display": {
          "$value": "{primitive.font.display}"
        },
        "sans": {
          "$value": "{primitive.font.body}"
        },
        "mono": {
          "$value": "{primitive.font.mono}"
        }
      },
      "radius": {
        "base": {
          "$value": "{primitive.radius.sm}"
        },
        "card": {
          "$value": "{primitive.radius.md}"
        }
      },
      "motion": {
        "ease-out": {
          "$value": "{primitive.ease.out}"
        },
        "ease-in-out": {
          "$value": "{primitive.ease.inout}"
        },
        "dur-fast": {
          "$value": "{primitive.duration.fast}"
        },
        "dur-base": {
          "$value": "{primitive.duration.base}"
        },
        "dur-slow": {
          "$value": "{primitive.duration.slow}"
        }
      }
    }
  },
  "component": {}
}